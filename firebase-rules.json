{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || data.child('created').val() < now - 86400000)",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)",
        "host": { ".validate": "newData.val() === auth.uid" },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('host').exists()",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 24"
          }
        },
        "answers": {
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/players/' + $uid).exists()",
              ".validate": "newData.child('c').isNumber() && newData.child('t').val() === now"
            }
          }
        }
      }
    }
  }
}
